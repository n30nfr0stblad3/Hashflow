# Hashflow Environment Variables
# Copy to .env and customize

# Mining pool
HASHFLOW_POOL=pool.supportxmr.com:3333

# Owner wallet file location
HASHFLOW_OWNER_CONFIG=owner_wallet.txt

# Donation range 0.02-0.05
HASHFLOW_MIN_DONATION=0.02
HASHFLOW_MAX_DONATION=0.05

# Group
HASHFLOW_GROUP_FILE=miners.json
HASHFLOW_MAX_GROUP_SIZE=100

# Performance
HASHFLOW_REFRESH_INTERVAL=3.0
HASHFLOW_CPU_PRIORITY=3
HASHFLOW_DONATE_LEVEL=0

# Stealth
HASHFLOW_LIMIT_CPU=0
HASHFLOW_STEALTH=false

# Dashboard
HASHFLOW_DASHBOARD_HOST=0.0.0.0
HASHFLOW_DASHBOARD_PORT=8080

# Data dir
HASHFLOW_DATA_DIR=/root/.hashflow
